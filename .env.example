# ─── Adobe UMAPI Credentials ──────────────────────────────────────────────────
# Required when AUTH_MODE=env (local dev only, single shared credential set).
# Create a Project with "User Management API" in Adobe Developer Console:
# https://developer.adobe.com/console
ADOBE_CLIENT_ID=your_client_id_here
ADOBE_CLIENT_SECRET=your_client_secret_here
ADOBE_ORG_ID=1234567890ABCDEF@AdobeOrg

# Optional: override the UMAPI base URL.
ADOBE_BASE_URL=https://usermanagement.adobe.io/v2/usermanagement

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) credentials provided per-request via three
#             HTTP headers: x-adobe-client-id, x-adobe-client-secret, x-adobe-org-id.
#             Required for production / multi-tenant deployments (e.g. behind mcp-gateway).
#             No credential or token is cached across requests — each call exchanges
#             its own short-lived Adobe IMS access_token (24h TTL, not reused).
# "env"     — (local dev only) single credential set loaded from ADOBE_CLIENT_ID /
#             ADOBE_CLIENT_SECRET / ADOBE_ORG_ID environment variables.
#             NOT SOP-compliant: credentials are shared across all requests; do not use in production.
AUTH_MODE=gateway
